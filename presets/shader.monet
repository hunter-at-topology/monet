// shader · write your own pictures and effects in WGSL.
// A picture returns the colour at uv. An effect reads the
// picture so far with pic(p), at any position. Parameters
// take numbers, patterns and signals, like the built-ins.

wgsl {
    // waves from three drifting points, added together
    fn swell(p: vec2f, t: f32, waves: f32) -> f32 {
        var h = 0.0;
        for (var i = 0; i < 3; i++) {
            let a = f32(i) * 2.1 + t * 0.3;
            let c = vec2f(cos(a), sin(a * 1.3)) * 0.35;
            h += sin(length(p - c) * waves * TAU - t * 2.0);
        }
        return h / 3.0;
    }
}

// rings from three drifting points, meeting and crossing
picture tide(colors = "monet", waves = 3) {
    let h = swell(asp(uv), u.time, waves);
    return vec4f(pal(colors, h * 0.5 + 0.5), 1.0);
}

// reeded glass: each rib shifts the picture, lit on one edge
effect pane(amount = .04, count = 16) {
    let x = fract(uv.x * count);
    let c = pic(uv + vec2f((x - 0.5) * amount, 0.0));
    return vec4f(c.rgb * (0.9 + 0.15 * smoothstep(0.2, 1.0, x)), c.a);
}

tide("<monet dawn>", sine.range(2, 3.5).slow(4))
  .pane()
  .grain(.03)
